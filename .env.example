# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/ruro_daily"

# ── NextAuth ──────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ── Admin access ──────────────────────────────────────────
# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS="you@ruro.in,cofounder@ruro.in"

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
DIGEST_FROM_EMAIL="digest@ruro.in"

# ── Cron protection ───────────────────────────────────────
# Sent as `Authorization: Bearer <CRON_SECRET>` by Vercel Cron
CRON_SECRET="generate-a-random-string"

# ── Scraper source API keys (optional, only if a source needs one) ──
ARXIV_API_BASE="http://export.arxiv.org/api/query"
GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# ── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://daily.ruro.in"
NEXT_PUBLIC_MAIN_SITE_URL="https://ruro.in"
# ── Newsletter & channels (all optional — each is skipped until set) ──
# See NEWSLETTER_SETUP.md
NEWSLETTER_SECRET="generate-a-random-string"   # signs unsubscribe links
BREVO_API_KEY=""
BREVO_LIST_ID=""                                # optional: Brevo list to add signups to
NEWSLETTER_FROM_EMAIL="edition@ruro.in"         # must be a verified sender in Brevo
NEWSLETTER_FROM_NAME="Ruro Daily"
SHEETS_WEBHOOK_URL=""                           # Google Apps Script web app URL
SHEETS_WEBHOOK_SECRET=""                        # same value as SECRET in the Apps Script
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""                          # e.g. @rurodaily
NEXT_PUBLIC_TELEGRAM_URL=""                     # e.g. https://t.me/rurodaily
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=""             # your WhatsApp Channel invite link

# ── Podcast (realistic voice) — optional; without it the player uses the device voice ──
GOOGLE_TTS_API_KEY=""                           # Google Cloud API key restricted to Text-to-Speech
GOOGLE_TTS_VOICE="en-IN-Neural2-A"              # any voice from cloud.google.com/text-to-speech/docs/voices
